{
  "name": "bjtu-plugin-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "migrate": "tsx src/migrate.ts",
    "test": "npm run build --silent && node dist/test/unit/run.js",
    "test:integration": "npm run build --silent && node dist/test/integration/run.js",
    "test:e2e": "npm run build --silent && node dist/test/e2e/run.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
