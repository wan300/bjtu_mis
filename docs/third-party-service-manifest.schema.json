{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bjtu-mis.local/schemas/third-party-service-manifest.schema.json",
  "title": "BJTU MIS Third Party Service Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "version",
    "entrypoint",
    "icon",
    "author",
    "runtime_version",
    "min_runtime_version",
    "required_capabilities",
    "optional_capabilities",
    "data_schema_version",
    "permissions",
    "connect_origins",
    "media_origins",
    "frame_origins",
    "navigation_origins",
    "bridge_origins",
    "marketplace",
    "configuration"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "version": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "runtime_version": {
      "type": "integer",
      "minimum": 1
    },
    "min_runtime_version": {
      "type": "integer",
      "minimum": 1
    },
    "required_capabilities": {
      "$ref": "#/$defs/capability_array"
    },
    "optional_capabilities": {
      "$ref": "#/$defs/capability_array"
    },
    "data_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "migration_entrypoint": {
      "$ref": "#/$defs/asset_path"
    },
    "entrypoint": {
      "$ref": "#/$defs/asset_path"
    },
    "icon": {
      "$ref": "#/$defs/asset_path",
      "pattern": "\\.(?:[sS][vV][gG]|[pP][nN][gG]|[wW][eE][bB][pP]|[jJ][pP][eE]?[gG])$",
      "description": "Path inside dist/ to an SVG, PNG, WebP, JPG, or JPEG icon no larger than 1 MiB."
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "$ref": "#/$defs/permission_array"
        },
        "optional": {
          "$ref": "#/$defs/permission_array"
        }
      }
    },
    "connect_origins": {
      "$ref": "#/$defs/origin_array",
      "description": "Origins available to browser fetch/XHR. Campus and private-network origins are rejected by semantic validation."
    },
    "media_origins": {
      "$ref": "#/$defs/origin_array"
    },
    "frame_origins": {
      "$ref": "#/$defs/origin_array"
    },
    "navigation_origins": {
      "$ref": "#/$defs/origin_array"
    },
    "bridge_origins": {
      "type": "array",
      "const": ["self"],
      "description": "The native bridge is available only to the stable local sandbox main frame."
    },
    "marketplace": {
      "$ref": "#/$defs/marketplace"
    },
    "configuration": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/configuration"
      }
    }
  },
  "$defs": {
    "asset_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "\\.\\." },
          { "pattern": "\\\\" },
          { "pattern": ":" }
        ]
      }
    },
    "permission_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "app.configuration.read",
          "identity.profile.read",
          "academic.timetable.read",
          "academic.user_courses.write",
          "academic.scores.read",
          "academic.history_scores.read",
          "academic.exams.read",
          "academic.calendar.read",
          "academic.progress.read",
          "academic.homework.read",
          "academic.homework.submit",
          "academic.course_resources.read",
          "mail.folders.read",
          "mail.messages.read",
          "mail.message_detail.read",
          "mail.send"
        ]
      }
    },
    "capability_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "runtime.lifecycle.v1",
          "storage.kv.v1",
          "campus.request.v1",
          "remote.frame.v1"
        ]
      }
    },
    "origin_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(https://[A-Za-z0-9.-]+(:[0-9]+)?|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?)/?$"
      }
    },
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "tags"],
      "properties": {
        "category": {
          "enum": ["academic", "campus", "information", "productivity", "assistant", "other"]
        },
        "tags": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          }
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "description", "type", "required"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 240
        },
        "type": {
          "enum": ["text", "secret", "url", "number", "boolean", "select"]
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
