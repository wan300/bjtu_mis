# Local H5 development example.
# The BJTU third-party service package only embeds the frontend.
# Keep VITE_API_BASE empty for local Vite proxy development, or set it to
# the backend origin that should be embedded into standalone H5 builds.
VITE_API_BASE=
VITE_API_PROXY_TARGET=http://47.95.238.140:8080
VITE_MP_API_BASE=http://47.95.238.140:8080
VITE_DEV_LOGIN_CODE=dev-code
