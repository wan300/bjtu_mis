{
  "name": "@bjtu-mis/plugin-cli",
  "version": "0.2.0",
  "description": "CLI for creating, validating, testing and packing BJTU MIS plugins",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bjtu": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "template",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bjtu-mis/plugin-sdk": "0.2.0"
  },
  "engines": {
    "node": ">=20 <=22"
  }
}
