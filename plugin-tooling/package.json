{
  "name": "bjtu-plugin-tooling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "npm run generate:check && npm run build -w @bjtu-mis/plugin-sdk && npm run build -w @bjtu-mis/plugin-cli && npm run build -w create-bjtu-plugin",
    "typecheck": "npm run generate:check && tsc -p tsconfig.json --noEmit && npm run template:check",
    "template:check": "tsc -p packages/plugin-cli/template/tsconfig.json --noEmit && node scripts/check-template.mjs",
    "test": "npm run build && node --test --experimental-test-isolation=none test/*.test.mjs",
    "pack:check": "npm run build && node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
