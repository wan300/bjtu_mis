<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/TimetableWidgetCourseRow">

    <TextView
        android:id="@+id/timetable_widget_calendar_item_bar"
        style="@style/TimetableWidgetCourseBar"
        android:text="" />

    <LinearLayout style="@style/TimetableWidgetCourseTextColumn">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timetable_widget_calendar_item_title"
                style="@style/TimetableWidgetCourseTitle"
                android:layout_width="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/timetable_widget_calendar_item_date"
                style="@style/TimetableWidgetCourseTime" />
        </LinearLayout>

        <TextView
            android:id="@+id/timetable_widget_calendar_item_detail"
            style="@style/TimetableWidgetCourseDetail" />
    </LinearLayout>
</LinearLayout>
