# Local environment and secrets
.env
.env.*
!.env.example
.venv/
venv/
android/local.properties
android/key.properties
android/keystore.properties
*.jks
*.keystore

# OS and editor state
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*.iml
**/.idea/workspace.xml
**/.idea/shelf/
**/.idea/caches/

# Automation captures and runtime state
/captures/
/runtime/
.github/java-upgrade/

# Gradle / Android build outputs
.gradle/
**/.gradle/
.kotlin/
**/.kotlin/
android/**/build/
android/app/schemas/
android/app/release/
*.apk
*.ap_
*.aab
*.aar
*.dex
*.class

# Capacitor / embedded web assets generated by sync or copy steps
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/assets/public/

# Embedded Open WebUI source is tracked; generated frontend state is not
android/open-webui/node_modules/
android/open-webui/build/
android/open-webui/.svelte-kit/
android/open-webui/static/pyodide/*
!android/open-webui/static/pyodide/pyodide-lock.json

# JVM and archive outputs
*.jar
!android/gradle/wrapper/gradle-wrapper.jar
*.war
*.ear

# Node / frontend dependency and build caches
node_modules/
.npm/
.pnpm-store/
.yarn/
.svelte-kit/
.vite/
dist/
out/
coverage/

# Logs and temporary files
logs/
log/
*.log
*.log.*
*.tmp
*.temp
*.bak
*.orig
*.rej

# Python bytecode generated by local tooling
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
